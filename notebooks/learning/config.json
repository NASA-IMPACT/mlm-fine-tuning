{
  "input": {
    "model": {
      "hf": "distilbert/distilroberta-base"
    },
    "dataset": {
      "hf": {
        "path": "wikimedia/wikipedia",
        "name": "20231101.en",
        "split": "train[:100]"
      },
      "val_split": 0.1,
      "test_split": 0.1,
      "chunk_size": 128,
      "mlm_probability": 0.15
    }
  },
  "TrainingArguments": {
    "per_device_train_batch_size": 16,
    "per_device_eval_batch_size": 16,
    "eval_strategy": "steps",
    "eval_steps": 100,
    "save_steps": 100,
    "logging_dir": "./logs",
    "logging_steps": 100,
    "num_train_epochs": 1,
    "save_total_limit": 2,
    "save_strategy": "steps",
    "optim": "adamw_torch",
    "learning_rate": 2e-5,
    "weight_decay": 0.01,
    "overwrite_output_dir": true,
    "do_train": true,
    "do_eval": true,
    "report_to": "wandb",
    "load_best_model_at_end": true,
    "metric_for_best_model": "eval_loss",
    "greater_is_better": false,
    "remove_unused_columns": true
  },
  "additional_training_config": {
    "training_patience": 4
  },
  "output": {
    "dir": "./model_outputs/",
    "model_backups_path": "tmp/models/",
    "final_model_path": "model/",
    "eval": "",
    "log": "model_log.txt"
  }
}
