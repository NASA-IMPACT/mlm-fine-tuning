{
  "input": {
    "model": {
      "hf": "nasa-impact/nasa-smd-ibm-v0.1"
    },
    "dataset": {
      "hf": {
        "path": "wikimedia/wikipedia",
        "name": "20231101.en"
      },
      "local": {
        "path": "parquet",
        "data_files": "../data/parsed_sde_init_check_with_title.parquet"
      },
      "val_split": 0.1,
      "test_split": 0.1,
      "chunk_size": 128,
      "mlm_probability": 0.15,
      "text_column": "text"
    }
  },
  "TrainingArguments": {
    "per_device_train_batch_size": 16,
    "per_device_eval_batch_size": 16,
    "eval_strategy": "steps",
    "eval_steps": 1000,
    "save_steps": 1000,
    "logging_dir": "./logs",
    "logging_steps": 1000,
    "num_train_epochs": 7,
    "save_total_limit": 2,
    "save_strategy": "steps",
    "optim": "adamw_torch",
    "learning_rate": 2e-5,
    "weight_decay": 0.01,
    "overwrite_output_dir": true,
    "do_train": true,
    "do_eval": true,
    "report_to": "wandb",
    "load_best_model_at_end": true,
    "metric_for_best_model": "eval_loss",
    "greater_is_better": false,
    "remove_unused_columns": true
  },
  "additional_training_config": {
    "training_patience": 3
  },
  "peft": {
    "r":64,
    "lora_alpha":16,
    "lora_dropout":0.1,
    "task_type":"CAUSAL_LM",
    "target_modules":["q_proj", "k_proj", "v_proj", "o_proj","gate_proj"]
  },
  "quant": {
    "bnb_config": {
      "load_in_4bit": true,
      "bnb_4bit_quant_type": "nf4"
    }
  },
  "output": {
    "dir": "./model_outputs/",
    "model_backups_path": "tmp/models/",
    "final_model_path": "model/",
    "eval": "",
    "log": "model_log.txt",
    "inference": {
        "top_k": 3,
        "n_predictions": 2000
    }
  }
}
