{
  "input": {
    "model": {
      "hf": "answerdotai/ModernBERT-base"
    },
    "dataset": {
      "hf": {
        "path": "wikimedia/wikipedia",
        "name": "20231101.en"
      },
      "local": {
        "path": "parquet",
        "data_files": "/rhome/sawale/indus_traning/mlm-fine-tuning/mlm/data/parsed_sde_init_check_with_title_filtered_word_count_yake.parquet"
      },
      "keyword_masking": {
        "key_extrator": "YAKE",
        "mlm_probablity": 0.30,
        "keyword_masking_probablity": 0.85,
        "keyword_selection_percentile": 50.0,
        "keyword_iou_threshold": 0.80
      },
      "kw_masking_type": {
        "static": true,
        "dynamic": false
      },
      "val_split": 0.1,
      "test_split": 0.1,
      "chunk_size": 1024,
      "mlm_probability": 0.15,
      "text_column": "text"
    }
  },
  "TrainingArguments": {
    "per_device_train_batch_size": 8,
    "per_device_eval_batch_size": 8,
    "eval_strategy": "steps",
    "eval_steps": 2000,
    "save_steps": 2000,
    "logging_dir": "./logs",
    "logging_steps": 2000,
    "num_train_epochs": 7,
    "save_total_limit": 3,
    "save_strategy": "steps",
    "learning_rate": 5e-5,
    "weight_decay": 0.01,
    "overwrite_output_dir": true,
    "do_train": true,
    "do_eval": true,
    "report_to": "wandb",
    "load_best_model_at_end": true,
    "metric_for_best_model": "eval_loss",
    "optim": "adamw_torch_fused",
    "greater_is_better": false,
    "remove_unused_columns": true,
    "fp16": false,
    "bf16": true
  },
  "additional_training_config": {
    "training_patience": 3
  },
  "peft": {
    "r":32,
    "lora_alpha":16,
    "lora_dropout":0.1,
    "task_type":"CAUSAL_LM",
    "target_modules":["q_proj", "k_proj", "v_proj", "o_proj","gate_proj"]
  },
  "quant": {
    "bnb_config": {
      "load_in_4bit": true,
      "bnb_4bit_quant_type": "nf4"
    }
  },
  "output": {
    "dir": "./model_outputs/",
    "model_backups_path": "tmp/models/",
    "final_model_path": "model/",
    "eval": "",
    "log": "model_log.txt",
    "inference": {
        "top_k": 3,
        "n_predictions": 2000
    }
  }
}
